@startuml 03_backend_components
title UML Component Diagram - Implemented Order Module
skinparam componentStyle uml
skinparam linetype ortho

package "WebAPI" {
    component "CreateOrderController" as Controller
}

package "Application" {
    component "CreateOrderUseCase" as UseCase
    interface "OrderRepository" as OrderRepositoryPort
    interface "InventoryAvailabilityPort" as InventoryPort
    interface "IEventPublisher" as EventPublisherPort
}

package "Domain" {
    component "Order" as Order
    component "OrderItem" as OrderItem
    component "Address" as Address
    component "OrderStatus" as OrderStatus
}

package "Infrastructure - In Memory" {
    component "InMemoryOrderRepository" as RepositoryAdapter
    component "InMemoryInventoryAvailabilityAdapter" as InventoryAdapter
    component "InMemoryEventBus" as EventBus
    component "InMemoryProcessedEventStore" as ProcessedStore

    component "StockReservationConsumer" as StockConsumer
    component "OrderNotificationConsumer" as NotificationConsumer
    component "PaymentAuditConsumer" as AuditConsumer
}

Controller --> UseCase : execute(command)
UseCase --> Order : creates aggregate
Order *-- OrderItem
Order *-- Address
Order --> OrderStatus

UseCase ..> OrderRepositoryPort : requires
UseCase ..> InventoryPort : requires
UseCase ..> EventPublisherPort : requires

RepositoryAdapter ..|> OrderRepositoryPort
InventoryAdapter ..|> InventoryPort
EventBus ..|> EventPublisherPort

EventBus --> StockConsumer : OrderCreatedEvent
EventBus --> NotificationConsumer : OrderCreatedEvent
EventBus --> AuditConsumer : PaymentProcessedEvent

StockConsumer --> ProcessedStore
NotificationConsumer --> ProcessedStore
AuditConsumer --> ProcessedStore

note bottom
All adapters and event consumers are instantiated
inside the same Spring application process.
The repository, event bus and processed-event store
are in-memory implementations, not external services.
end note
@enduml
