@startuml 04_domain_class_diagram
title UML Domain Class Diagram - Implemented Order Domain
skinparam classAttributeIconSize 0
hide empty members

class Order {
  -id: UUID
  -customerId: UUID
  -items: List<OrderItem>
  -shippingAddress: Address
  -totalAmount: BigDecimal
  -status: OrderStatus
  -createdAt: Instant
  +create(customerId, items, shippingAddress): Order
  +getId(): UUID
  +getCustomerId(): UUID
  +getItems(): List<OrderItem>
  +getTotalAmount(): BigDecimal
  +getStatus(): OrderStatus
  +getCreatedAt(): Instant
}

class OrderItem {
  -productId: UUID
  -quantity: int
  -unitPrice: BigDecimal
  +subtotal(): BigDecimal
}

class Address {
  -country: String
  -city: String
  -street: String
  -building: String
  -postalCode: String
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

interface OrderRepository {
  +save(order: Order): Order
}

Order "1" *-- "1..*" OrderItem
Order "1" *-- "1" Address
Order --> OrderStatus
OrderRepository ..> Order : persists

note bottom
The diagram contains domain types present in the
current source code. It does not model future
Customer, Product, Cart, Payment or Shipment aggregates.
end note
@enduml
